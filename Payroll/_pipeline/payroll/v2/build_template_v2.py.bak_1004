"""Build a clean v2 payroll workbook from scratch.

Tabs:
  Inputs           — period start, daily CC tips, shifts CSV (paste here)
  Roster           — employee directory: ADP name, standard wage, primary location
  Roles            — Square job title → role group + tipped flag
  Calc             — auto-aggregated per (employee × location × role)
  Output (ADP)     — alphabetical entry list, ADP-column-ordered
  Location Totals  — per-location hours/labor/tips
  Checks           — reconciliation: hours match, tips match, min wage holds
  README           — how to use

Design principles:
  • Single source of truth for each input (paste once)
  • SUMIFS / SUMPRODUCT, not CSE array formulas with hardcoded ranges
  • Adding/removing a location = edit Roster, Calc auto-updates
  • Adding/removing a job title = edit Roles, no formula changes
  • Output tab is what the user types into ADP, sorted to match ADP's order
"""
from __future__ import annotations
import datetime as dt
from pathlib import Path

import openpyxl
from openpyxl.styles import Alignment, Border, Font, PatternFill, Side
from openpyxl.utils import get_column_letter
from openpyxl.worksheet.table import Table, TableStyleInfo
from openpyxl.workbook.defined_name import DefinedName
from openpyxl.formatting.rule import CellIsRule, FormulaRule
from openpyxl.styles.differential import DifferentialStyle

ROOT = Path(__file__).resolve().parent
OUT = ROOT / "template_v2.xlsx"

# Slipstream's color protocol (per memory): blue=input, green=pull, black=formula
COL_INPUT  = "1F4E78"   # dark blue
COL_PULL   = "548235"   # green
COL_HEADER = "1F4E78"
COL_LABEL  = "2F2F2F"

FILL_INPUT_BG  = PatternFill("solid", fgColor="D9E1F2")  # light blue
FILL_LOOKUP_BG = PatternFill("solid", fgColor="E2EFDA")  # light green
FILL_HEADER    = PatternFill("solid", fgColor="305496")  # dark navy
FILL_BAND      = PatternFill("solid", fgColor="F2F2F2")  # light gray
FILL_WARN      = PatternFill("solid", fgColor="FFE699")  # warm yellow
FILL_OK        = PatternFill("solid", fgColor="C6EFCE")  # green pass
FILL_FAIL      = PatternFill("solid", fgColor="FFC7CE")  # red fail

FONT_HEADER  = Font(name="Calibri", size=11, bold=True, color="FFFFFF")
FONT_LABEL   = Font(name="Calibri", size=11, bold=True)
FONT_INPUT   = Font(name="Calibri", size=11, color="1F4E78", bold=False)
FONT_PULL    = Font(name="Calibri", size=11, color="548235", bold=False)
FONT_FORMULA = Font(name="Calibri", size=11)

THIN = Side(border_style="thin", color="BFBFBF")
THICK = Side(border_style="medium", color="305496")


